<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1603</NoWarn>
    <Nullable>enable</Nullable>
    <UserSecretsId>f08719fd-267f-459e-9980-77b1c52c8755</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Force the transitive MessagePack (via Aspire.Hosting/KubernetesClient) up to a
         patched version to resolve NU1903 (GHSA-hv8m-jj95-wg3x). -->
    <PackageReference Include="MessagePack" />
    <!-- Aspire 13 requires the patched 10.x Pkcs; keep this override local to the development host. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="10.0.14" />
    <!-- Align SqlClient's IdentityModel family instead of allowing partial transitive upgrades. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" VersionOverride="8.17.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" VersionOverride="8.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service\Azure.DataApiBuilder.Service.csproj" />
  </ItemGroup>

</Project>
